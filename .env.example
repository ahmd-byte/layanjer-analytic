# AI Provider
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_PRIMARY_MODEL=deepseek-chat
AI_REASONING_MODEL=deepseek-reasoner
AI_VISION_MODEL=
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3
AI_DAILY_BUDGET=5.00

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Application
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOG_LEVEL=INFO
APP_DATA_DIR=./local_data
APP_BACKUP_DIR=./backups

# Browser
BROWSER_HEADLESS=false
BROWSER_PROFILES_DIR=./browser_profiles
BROWSER_TIMEOUT=30000

# Facebook: Page or profile names to pull, first match wins (comma-separated).
# Empty = the first Page the signed-in user manages.
FACEBOOK_TARGET_PAGES=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
